{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-coe/license.schema.json",
  "title": "AI License Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "license_id", "tool_name", "vendor", "capacity", "status", "last_updated"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "license_id": {"type": "string", "pattern": "^LIC-[0-9]{4}$"},
    "tool_name": {"type": "string", "minLength": 2},
    "vendor": {"type": "string", "minLength": 2},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purchased", "assigned", "available"],
      "properties": {
        "purchased": {"type": "integer", "minimum": 0},
        "assigned": {"type": "integer", "minimum": 0},
        "available": {"type": "integer", "minimum": 0}
      }
    },
    "funding_owner": {"type": ["string", "null"]},
    "renewal_date": {"type": ["string", "null"], "format": "date"},
    "supported_use_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AI-[0-9]{4}$"}
    },
    "status": {"type": "string"},
    "notes": {"type": ["string", "null"]},
    "last_updated": {"type": "string", "format": "date"}
  }
}
