{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-coe/use-case.schema.json",
  "title": "AI Use Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ai_id", "name", "department", "description", "ownership", "governance", "inventory", "risk", "dates", "record_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ai_id": {"type": "string", "pattern": "^AI-[0-9]{4}$"},
    "name": {"type": "string", "minLength": 3},
    "department": {"type": "string", "minLength": 2},
    "description": {"type": "string", "minLength": 10},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_owner", "coe_owner"],
      "properties": {
        "sponsor": {"type": ["string", "null"]},
        "business_owner": {"type": "string", "minLength": 2},
        "coe_owner": {"type": "string", "minLength": 2}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "substage", "gate_status", "priority", "build_buy"],
      "properties": {
        "phase": {"type": "string"},
        "substage": {"type": "string"},
        "gate_status": {"type": "string"},
        "priority": {"type": "string"},
        "build_buy": {"type": "string"},
        "next_gate": {"type": ["string", "null"]},
        "next_gate_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "operational_status"],
      "properties": {
        "bucket": {"type": "string"},
        "operational_status": {"type": "string"},
        "backlog_reason": {"type": ["string", "null"]},
        "resolution": {"type": ["string", "null"]}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "data_sensitivity", "resident_facing", "public_safety", "human_oversight"],
      "properties": {
        "tier": {"type": "string"},
        "data_sensitivity": {"type": "string"},
        "resident_facing": {"type": "boolean"},
        "public_safety": {"type": "boolean"},
        "human_oversight": {"type": "string"}
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["license_id", "quantity", "status"],
        "properties": {
          "license_id": {"type": "string", "pattern": "^LIC-[0-9]{4}$"},
          "quantity": {"type": "integer", "minimum": 0},
          "status": {"type": "string"}
        }
      }
    },
    "monitoring": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "string"},
        "cadence": {"type": "string"},
        "plan_url": {"type": ["string", "null"]},
        "last_reviewed": {"type": ["string", "null"], "format": "date"}
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "last_updated"],
      "properties": {
        "created": {"type": "string", "format": "date"},
        "last_updated": {"type": "string", "format": "date"},
        "target_production": {"type": ["string", "null"], "format": "date"},
        "go_live": {"type": ["string", "null"], "format": "date"},
        "closed": {"type": ["string", "null"], "format": "date"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "record_status": {"type": "string"}
  }
}
