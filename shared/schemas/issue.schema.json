{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-coe/issue.schema.json",
  "title": "AI Operational Issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "ai_id", "summary", "issue_type", "severity", "status", "owner", "date_opened", "last_updated"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issue_id": {"type": "string", "pattern": "^ISS-[0-9]{4}$"},
    "ai_id": {"type": "string", "pattern": "^AI-[0-9]{4}$"},
    "summary": {"type": "string", "minLength": 5},
    "issue_type": {"type": "string", "minLength": 2},
    "severity": {"type": "string"},
    "status": {"type": "string"},
    "owner": {"type": "string", "minLength": 2},
    "date_opened": {"type": "string", "format": "date"},
    "date_closed": {"type": ["string", "null"], "format": "date"},
    "resolution": {"type": ["string", "null"]},
    "governance_escalation": {"type": "boolean"},
    "last_updated": {"type": "string", "format": "date"}
  }
}
